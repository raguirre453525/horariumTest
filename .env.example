# Public browser credentials (safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Feature flag for live notes (CTA + pinned card + cron)
LIVE_NOTES_ENABLED=true
LIVE_NOTE_DURATION_HOURS=4

# Server-only: Supabase service_role (never NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: Google Service Account for Drive (never NEXT_PUBLIC_*)
# Base64-encoded JSON of the SA key file (cat sa.json | base64 -w0)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_JSON=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...
GOOGLE_DRIVE_ROOT_ID=your-drive-root-folder-id

# Server-only: cron guard for POST /api/cron/archive-live-notes
CRON_SECRET=your-random-cron-secret

# Server-only: WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_GRAPH_VERSION=v21.0

# Server-only: DeepSeek OpenAI-compatible
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Server-only: bot timezone and link hash salt
HORARIUM_TIMEZONE=America/Argentina/Buenos_Aires
WHATSAPP_LINK_HASH_SALT=change-me-random
